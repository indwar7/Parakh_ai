# Gemini — diagnosis agent reasoning
GEMINI_API_KEY=

# Razorpay test-mode credentials — used by the executor to actually call
# create_payment_link / fetch_payment / refund etc. Get these from the
# Razorpay Dashboard (Test Mode) → Settings → API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set to "mock" to run the whole demo without any real Razorpay calls
# (safe default until keys are wired up). Set to "razorpay" once ready.
EXECUTOR_MODE=mock
